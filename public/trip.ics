BEGIN:VEVENT
UID:jp-trip-20-1795297800000@trip
DTSTAMP:20261112T153700Z
DTSTART:20261121T215000Z
DTEND:20261121T220000Z
SUMMARY:Metro: Ginza Line\, Ueno → Asakusa
DESCRIPTION:Leave Grids by 06:40. Walk about 6 min south along the east side of JR Ueno Station to the Tokyo Metro entrance. Ginza Line (G\, orange) from Ueno G16 toward 浅草 Asakusa\, 3 stops to Asakusa G19\, ~5 min. Exit 1 for the Kaminarimon gate.
LOCATION:Kaminarimon Asakusa
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Metro: Ginza Line\, Ueno → Asakusa
TRIGGER:-PT15M
END:VALARM
